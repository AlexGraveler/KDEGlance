[Desktop Entry]
Type=Service
Name=KDEGlance
X-KDE-AliasFor=io.github.KDEGlance2
MimeType=image/jpeg;image/png;image/webp;image/bmp;image/gif;image/heif;image/heic;image/x-canon-cr2;audio/mpeg;audio/flac;audio/x-flac;audio/ogg;audio/x-vorbis+ogg;application/ogg;audio/wav;audio/x-wav;audio/mp4;audio/x-m4a;audio/aac;audio/x-aac;video/mp4;video/x-matroska;video/webm;video/x-msvideo;video/quicktime;video/x-m4v;video/mpeg;video/mp2t;video/ogg;video/3gpp;video/x-ms-wmv;video/x-flv;application/vnd.rn-realmedia;video/vnd.rn-realvideo;
Actions=LogSelection;
X-KDE-Protocols=file,smb
X-KDE-RequiredNumberOfUrls=1

[Desktop Action LogSelection]
Name=KDEGlance: Quick Look
Name[ru]=KDEGlance: быстрый просмотр
Icon=image-viewer
Exec=/usr/bin/kdeglance toggle -- %U
