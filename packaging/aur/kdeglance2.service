[Unit]
Description=KDEGlance file preview
PartOf=graphical-session.target
After=graphical-session-pre.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=dbus
BusName=io.github.KDEGlance2
ExecStart=/usr/bin/python3 -B /usr/lib/kdeglance/package_launch.py daemon
Environment=QT_QPA_PLATFORM=wayland
UMask=0077
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=1
TimeoutStopSec=10

[Install]
WantedBy=graphical-session.target
