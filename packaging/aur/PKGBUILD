build() {
  cd "$srcdir/KDEGlance-$pkgver/kdeglance"
  # Honor makepkg hardening/optimization/link flags; no prebuilt developer .so.
  ${CXX:-g++} $CPPFLAGS $CXXFLAGS -std=c++20 -fPIC -shared native.cpp \
    $LDFLAGS -o libkdeglance_native.so $(pkg-config --cflags --libs 'Qt6Gui >= 6.8' 'KF6WindowSystem >= 6.0')
}

check() {
  python -B "$srcdir/check_package.py" "$srcdir"
  desktop-file-validate "$srcdir/io.github.KDEGlance2.desktop"
  sh -n "$srcdir/kdeglance" "$srcdir/kdeglance-setup"
}

package() {
  local module
  cd "$srcdir/KDEGlance-$pkgver/kdeglance"
  for module in core loader window daemon client audio audio_metadata dolphin_order \
      dolphin_order_worker video interactions remote animation visuals legacy; do
    install -Dm644 "$module.py" "$pkgdir/usr/lib/kdeglance/$module.py"
  done
  install -Dm755 libkdeglance_native.so "$pkgdir/usr/lib/kdeglance/libkdeglance_native.so"
  for module in package_launch package_support user_setup; do
    install -Dm644 "$srcdir/$module.py" "$pkgdir/usr/lib/kdeglance/$module.py"
  done
  install -Dm755 "$srcdir/kdeglance" "$pkgdir/usr/bin/kdeglance"
  ln -s kdeglance "$pkgdir/usr/bin/kdeglance2"
  install -Dm755 "$srcdir/kdeglance-setup" "$pkgdir/usr/bin/kdeglance-setup"
  install -Dm644 "$srcdir/kdeglance2.service" "$pkgdir/usr/lib/systemd/user/kdeglance2.service"
  install -Dm644 "$srcdir/io.github.KDEGlance2.service" "$pkgdir/usr/share/dbus-1/services/io.github.KDEGlance2.service"
  install -Dm644 "$srcdir/io.github.KDEGlance2.desktop" "$pkgdir/usr/share/applications/io.github.KDEGlance2.desktop"
  install -Dm644 "$srcdir/kdeglance-space-probe.desktop" "$pkgdir/usr/share/kio/servicemenus/kdeglance-space-probe.desktop"
  install -Dm644 "$srcdir/KDEGlance-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/NOTICES.md" "$pkgdir/usr/share/licenses/$pkgname/NOTICES.md"
  install -Dm644 "$srcdir/AUR-INSTALL.md" "$pkgdir/usr/share/doc/$pkgname/AUR-INSTALL.md"
}
